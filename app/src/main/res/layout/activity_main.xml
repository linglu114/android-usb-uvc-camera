<?xml version="1.0" encoding="utf-8"?>
<!--
  单屏预览（Dark-first monitor HUD）。
  层级：预览 -> 空状态 -> 加载态 -> 顶部遮罩 -> 顶部栏(元数据 + 设置入口) -> 状态条。
  设计约定：控件尽量少、全部 >=48dp；横屏进入即隐藏全部控件（沉浸），点击屏幕唤出。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_canvas">

    <!-- 预览容器：库会把 AspectRatioTextureView 注入这里 -->
    <FrameLayout
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 空状态：三等分自诊断指引 + 两个可操作出口 -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_empty_placeholder"
            android:contentDescription="@string/cd_empty_illustration" />

        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/empty_title"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="@color/hud_on_surface" />

        <TextView
            android:id="@+id/tv_empty_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/empty_steps_default"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/hud_on_surface_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_request_permission"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:minHeight="@dimen/touch_target"
            android:text="@string/action_request_permission" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rescan"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:minHeight="@dimen/touch_target"
            android:text="@string/action_rescan" />
    </LinearLayout>

    <!-- 加载态 -->
    <LinearLayout
        android:id="@+id/loading_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_empty_placeholder"
            android:minHeight="180dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading_opening"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/hud_on_surface_variant" />
    </LinearLayout>

    <!-- 顶部可读性遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_scrim_height"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim" />

    <!-- 顶部栏：左侧元数据，右侧设置入口（唯一控件入口） -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tv_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.UsbCam.Meta"
            android:textColor="@color/hud_on_surface"
            tools:text="MS2109 · 1280×720" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            style="@style/Widget.UsbCam.IconButton"
            android:contentDescription="@string/cd_settings"
            app:icon="@drawable/ic_more"
            app:iconTint="@color/hud_on_surface" />
    </LinearLayout>

    <!-- 状态条：连接状态点 + 说明（贴近底部） -->
    <LinearLayout
        android:id="@+id/status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/screen_padding"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <View
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_status_dot" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/state_disconnected"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/hud_on_surface" />
    </LinearLayout>
</FrameLayout>
