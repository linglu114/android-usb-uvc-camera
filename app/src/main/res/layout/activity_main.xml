<?xml version="1.0" encoding="utf-8"?>
<!--
  单屏预览界面（Dark-first monitor HUD）。
  层级：预览 -> 空状态 -> 顶部遮罩+元数据 -> 状态条 -> 底部控制条。
  所有触控目标 >= 48dp；内容避开系统栏（window insets 在代码中应用）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_canvas">

    <!-- 预览容器：库会把 AspectRatioTextureView 注入这里 -->
    <FrameLayout
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 空状态：三等分自诊断指引，居中但非卡片阵列 -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_empty_placeholder"
            android:contentDescription="@string/cd_empty_illustration" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/empty_title"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="@color/hud_on_surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/empty_step_1"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/hud_on_surface_variant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/empty_step_2"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/hud_on_surface_variant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/empty_step_3"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/hud_on_surface_variant" />
    </LinearLayout>

    <!-- 加载态：等比骨架，不用通用转圈 -->
    <LinearLayout
        android:id="@+id/loading_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0"
            android:background="@drawable/bg_empty_placeholder"
            android:layout_gravity="center_horizontal"
            android:minHeight="180dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading_opening"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/hud_on_surface_variant" />
    </LinearLayout>

    <!-- 顶部：可读性遮罩 + 元数据 + 退出 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_scrim_height"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exit"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/action_exit"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="@dimen/touch_target"
            android:minHeight="@dimen/touch_target"
            app:icon="@drawable/ic_close"
            app:iconPadding="0dp"
            app:iconTint="@color/hud_on_surface" />

        <TextView
            android:id="@+id/tv_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.UsbCam.Meta"
            android:textColor="@color/hud_on_surface"
            android:textIsSelectable="false"
            tools:text="MS2109 · 1280×720" />
    </LinearLayout>

    <!-- 状态条：连接状态点 + 说明 -->
    <LinearLayout
        android:id="@+id/status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <View
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_status_dot" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/state_disconnected"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/hud_on_surface" />
    </LinearLayout>

    <!-- 底部控制条：6 个 48dp 目标，单行 -->
    <LinearLayout
        android:id="@+id/control_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_bar_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_control_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_device"
            style="@style/Widget.UsbCam.IconButton"
            android:contentDescription="@string/cd_device"
            app:icon="@drawable/ic_device"
            app:iconTint="@color/hud_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_resolution"
            style="@style/Widget.UsbCam.IconButton"
            android:contentDescription="@string/cd_resolution"
            app:icon="@drawable/ic_resolution"
            app:iconTint="@color/hud_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rotate"
            style="@style/Widget.UsbCam.IconButton"
            android:contentDescription="@string/cd_rotate"
            app:icon="@drawable/ic_rotate"
            app:iconTint="@color/hud_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mirror"
            style="@style/Widget.UsbCam.IconButton"
            android:contentDescription="@string/cd_mirror"
            app:icon="@drawable/ic_mirror"
            app:iconTint="@color/hud_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_keep_on"
            style="@style/Widget.UsbCam.IconButton"
            android:contentDescription="@string/cd_keep_screen_on"
            app:icon="@drawable/ic_keep_screen_on"
            app:iconTint="@color/hud_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_more"
            style="@style/Widget.UsbCam.IconButton"
            android:contentDescription="@string/cd_more"
            app:icon="@drawable/ic_more"
            app:iconTint="@color/hud_on_surface" />
    </LinearLayout>
</FrameLayout>
