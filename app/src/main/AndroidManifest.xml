<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- USB 主设备（OTG）；非必需，缺失时仅空状态提示，不阻止安装 -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!--
      CAMERA 必须保留（上游库声明它，且有实证原因）：
      StackOverflow 61542540 的实测结论是——部分 ROM 在应用未持有 CAMERA 权限时，
      UsbManager.requestPermission 会被直接拒绝且不弹授权对话框。
      本机 ColorOS 15 / Android 15 实测复现：移除 CAMERA 后，应用发出的授权请求
      得到 onReceive(USB_PERMISSION, device=null)、权限始终 DENIED。
      本应用只用外接 UVC 设备，不会调用内置相机，此处保留仅为换取 USB 授权通道。

      RECORD_AUDIO：首版不做音频（CameraRequest.AudioSource.NONE），移除。
      USB_PERMISSION：并非真实系统权限，属误声明，移除。
    -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USB_PERMISSION"
        tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.UsbCam">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 插入 USB 设备即可唤起本应用 -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/default_device_filter" />
        </activity>
    </application>
</manifest>
